# DATABASE
POSTGRES_USER=appguard
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=appguard-db
APPGUARD_SEED_DATABASE=true
POSTGRES_VERSION=17

# IMAGES
# Containers are pulled from registry.gitlab.com by default (no local build).
# APPGUARD_IMAGE_TAG: image tag to pull. "latest" tracks the main branch, or pin a
# release (e.g. 2.4.3). The install script sets this from the release it ships.
APPGUARD_IMAGE_TAG=2.4.3
# Pro:
# `docker login registry.gitlab.com`
#   registry.gitlab.com/servasec/appguard-pro/backend
APPGUARD_BACKEND_IMAGE=registry.gitlab.com/servasec/appguard/backend

# APP CONFIG
APPGUARD_SITE_NAME="appguard"
APPGUARD_PUBLIC_URL="https://appguard.example.com"
APPGUARD_PUBLIC_DOMAIN="appguard.example.com"
APPGUARD_REGISTRATION_ENABLED=false
APPGUARD_DEBUG_ENABLED=false
APPGUARD_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
APPGUARD_LICENSE_KEY=

# MULTI-TENANT / EDGE
APPGUARD_CONTAINER_PREFIX=
APPGUARD_EDGE_MODE=false
CADDY_HTTP_BIND=0.0.0.0:80
CADDY_HTTPS_BIND=0.0.0.0:443
APPGUARD_NETWORK_PUBLIC_SUBNET=172.70.1.0/24
APPGUARD_NETWORK_PRIVATE_SUBNET=172.70.2.0/24
TRUSTED_PROXIES_CIDR=

# SECURITY
# All secrets must be at least 32 bytes (256 bits).
# Use: openssl rand -base64 32  (generates a 44-char base64 string)
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
REFRESH_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
CSRF_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
APPGUARD_FEATURES_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32

# DOCKER USER (set to your host UID:GID to avoid root-owned files)
# USER_UID=1000
# USER_GID=1000
# Or use: make dev (handles it automatically)



# SSO / SOCIAL LOGIN (leave empty to disable each provider)
# SSO_GITHUB_CLIENT_ID=
# SSO_GITHUB_CLIENT_SECRET=
# SSO_GITLAB_CLIENT_ID=
# SSO_GITLAB_CLIENT_SECRET=
# SSO_GITLAB_BASE_URL=              # optional, for self-hosted GitLab
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_ISSUER_URL=              # ex: https://my-keycloak.example.com/realms/master
# SSO_OIDC_SCOPES=openid profile email
